# Environment Template
# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Better Auth
BETTER_AUTH_SECRET=your_secret_here_min_32_chars

# Redis (Upstash)
REDIS_URL=redis://default:password@host:port

# Payment Gateways
JAZZ_CASH_MERCHANT_ID=your_merchant_id
JAZZ_CASH_SECRET=your_secret_key
JAZZ_CASH_PP_PASSWORD=your_pp_password
EASYPAISA_MERCHANT_ID=your_merchant_id
EASYPAISA_SECRET=your_secret_key

# Email Configuration
NEXT_PUBLIC_SUPPORT_EMAIL=support@muskancare.com
NEXT_PUBLIC_SUPPORT_PHONE=+92-3XX-XXXXXXX
NEXT_PUBLIC_WEBSITE_URL=https://muskancare.com
