# Environment Template
# Copy to .env.local and fill in real values. Never commit real credentials.

# Supabase Configuration (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# JWT secret from Supabase Project Settings -> API -> JWT Secret.
# Must match the project's JWT secret (used to verify session tokens).
SUPABASE_JWT_SECRET=your_jwt_secret_here

# Site URL (required) - production must be the public HTTPS domain.
# Used for payment callbacks, redirects, and auth email links.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Payment Gateways (required for live payments)
# JazzCash
JAZZ_CASH_MERCHANT_ID=your_merchant_id
JAZZ_CASH_PP_PASSWORD=your_pp_password
# Easypaisa
EASYPAISA_MERCHANT_ID=your_merchant_id
EASYPAISA_SECRET=your_secret_key

# Email (required for transactional email; defaults to Resend)
EMAIL_PROVIDER=resend
RESEND_API_KEY=your_resend_api_key
# IMPORTANT: Verify your domain at resend.com/domains before using a custom from address.
# In Resend test mode, emails can only be sent to the account owner's email.
# Use onboarding@resend.dev for testing (limited to account owner's email).
EMAIL_FROM=noreply@your-domain.com

# Cron (required for scheduled tasks like low-stock digest)
CRON_SECRET=your_random_secret_here

# Admin (required for admin notifications)
ADMIN_EMAIL=admin@your-domain.com
